<?xml version="1.0" encoding="utf-8"?>
<!-- GVoice fetches only its pinned Whisper models, over HTTPS with the system's certificate authorities. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
